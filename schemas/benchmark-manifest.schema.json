{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrossTaint benchmark manifest",
  "type": "object",
  "required": ["benchmark_name", "version", "cases"],
  "properties": {
    "benchmark_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "evidence_scope": {
      "type": "string",
      "enum": ["historical_corpus", "synthetic_oracle"]
    },
    "oracle_metadata": {
      "type": "object",
      "required": ["description", "independent_provenance"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "independent_provenance": {"const": false},
        "generator": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "benign_addresses": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["address", "chain"],
            "properties": {
              "node_id": {"type": "string"},
              "address": {"type": "string", "minLength": 1},
              "chain": {"type": "string", "minLength": 1},
              "node_type": {"type": "string"},
              "tags": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_node", "target_node"],
            "properties": {
              "edge_id": {"type": "string"},
              "source_node": {"type": "string", "minLength": 1},
              "target_node": {"type": "string", "minLength": 1},
              "edge_type": {"type": "string"},
              "operator": {"type": "string"},
              "bridge": {"type": "string"},
              "value": {"type": "integer", "minimum": 0},
              "fee_bound_pct": {"type": "number", "minimum": 0}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["origin", "hops"],
        "properties": {
          "case_id": {"type": "string"},
          "name": {"type": "string"},
          "incident_date": {"type": "string"},
          "ground_truth_sources": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "origin": {
            "type": "object",
            "required": ["address", "chain", "value"],
            "properties": {
              "address": {"type": "string", "minLength": 1},
              "chain": {"type": "string", "minLength": 1},
              "value": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "hops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["to_chain", "bridge", "address"],
              "properties": {
                "from_chain": {"type": "string"},
                "to_chain": {"type": "string", "minLength": 1},
                "bridge": {"type": "string", "minLength": 1},
                "address": {"type": "string", "minLength": 1},
                "value": {"type": "integer", "minimum": 0},
                "asset": {"type": ["string", "null"]},
                "operator": {"type": "string"},
                "source_event": {"type": ["string", "null"]},
                "target_event": {"type": ["string", "null"]},
                "timestamp": {},
                "block_number": {"type": "integer", "minimum": 0},
                "fee_bound_pct": {"type": "number", "minimum": 0},
                "sources": {
                  "type": "array",
                  "minItems": 2,
                  "items": {"type": "string", "minLength": 1}
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"evidence_scope": {"const": "synthetic_oracle"}},
        "required": ["evidence_scope"]
      },
      "then": {"required": ["oracle_metadata"]}
    }
  ],
  "additionalProperties": true
}
